# Copie para .env (NUNCA commitar) e preencha com os valores do Supabase
# (painel do Supabase → Project Settings → API). A chave service role dá acesso
# total ao banco: guarde só neste computador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-aqui
# Slug do workspace (parte da URL /a/<slug>/...). Opcional se o banco tiver 1 workspace.
UNDERCUT_WORKSPACE=
