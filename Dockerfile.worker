# Robô WhatsApp do Undercut rodando 24 h em servidor (Railway, Fly.io, Render, VPS…).
#   docker build -f Dockerfile.worker -t undercut-robo .
# Variáveis: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, UNDERCUT_WORKSPACE (opcional), HUB_URL (opcional)
# Volume persistente em /data (guarda o login do WhatsApp — sem ele você precisaria ler o QR a cada reinício).
FROM node:22.18-slim
WORKDIR /app
COPY apps/whatsapp-worker/package.json apps/whatsapp-worker/package-lock.json ./apps/whatsapp-worker/
RUN npm --prefix apps/whatsapp-worker ci --omit=dev
COPY apps/whatsapp-worker ./apps/whatsapp-worker
COPY lib/sdr/providers ./lib/sdr/providers
ENV WORKER_DATA_DIR=/data TZ=America/Sao_Paulo NODE_ENV=production
VOLUME ["/data"]
CMD ["node", "apps/whatsapp-worker/src/index.mjs"]
