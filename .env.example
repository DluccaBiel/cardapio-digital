# ============================================================================
# Orvia — variáveis de ambiente (EXEMPLO COM PLACEHOLDERS)
# NUNCA commite .env real. Copie para .env.local e preencha localmente.
# ============================================================================

# ============================================================================
# SUPABASE
# ============================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sb_public_chave_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sb_secret_chave_service_role_aqui   # SOMENTE servidor
SUPABASE_DB_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres  # backups/psql
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json

# ============================================================================
# NEXT.JS
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_public_chave_publica_aqui
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# SEGURANÇA
# ============================================================================
JWT_SECRET=gere_uma_string_aleatoria_longa_aqui
WEBHOOK_SECRET=whsec_gere_uma_string_aleatoria_aqui        # fallback/global; cada webhook tem seu secret
ENCRYPTION_KEY=gere_32_bytes_base64_aqui                   # ex.: openssl rand -base64 32 (Vault/secrets)
CRON_SECRET=gere_uma_string_aleatoria_para_o_cron_aqui     # protege /api/cron/*

# Origens permitidas por CORS para extensões (lista separada por vírgula)
ALLOWED_EXTENSION_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# ============================================================================
# RATE LIMIT
# ============================================================================
API_RATE_LIMIT_MAX=60                 # requisições por minuto por chave (padrão)
API_RATE_LIMIT_WINDOW=60              # janela em segundos

# ============================================================================
# EXTENSÕES
# ============================================================================
EXTENSION_SIGNING_SECRET=gere_uma_string_aleatoria_aqui    # assinatura de releases de extensão (futuro)

# ============================================================================
# RETENÇÃO (dias) — ver docs/fotos-e-historico.md e docs/decisoes-em-aberto.md
# ============================================================================
IMAGE_HISTORY_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_IP_RETENTION_DAYS=90
